      "startFrame": 3,
      "durationFrames": 138,
      "plannedDurationSeconds": 4.6,
      "voiceText": "Diese Warnung beim Überweisen solltest du nicht einfach wegklicken."
    },
    {
      "id": "scene-03",
      "type": "image",
      "startFrame": 141,
      "durationFrames": 108,
      "plannedDurationSeconds": 3.6,
      "voiceText": "Seit dem 9. Oktober 2025 gilt der neue Empfängercheck."
    },
    {
      "id": "scene-04",
      "type": "animation",
      "startFrame": 249,
      "durationFrames": 132,
      "plannedDurationSeconds": 4.4,
      "voiceText": "Vor der Freigabe vergleicht die Bank Empfängername und IBAN."
    },
    {
      "id": "scene-05",
      "type": "image",
      "startFrame": 381,
      "durationFrames": 108,
      "plannedDurationSeconds": 3.6,
      "voiceText": "Passen beide zusammen, bekommst du ein Match."
    },
    {
      "id": "scene-06",
      "type": "animation",
      "startFrame": 489,
      "durationFrames": 135,
      "plannedDurationSeconds": 4.5,
      "voiceText": "Bei kleinen Abweichungen kann ein Hinweis erscheinen – etwa bei einem Tippfehler."
    },
    {
      "id": "scene-07",
      "type": "image",
      "startFrame": 624,
      "durationFrames": 108,
      "plannedDurationSeconds": 3.6,
      "voiceText": "Passen die Daten nicht zusammen, wirst du gewarnt."
    },
    {
      "id": "scene-08",
      "type": "image",
      "startFrame": 732,
      "durationFrames": 120,
      "plannedDurationSeconds": 4,
      "voiceText": "Du kannst trotzdem senden – aber dann trägst du ein höheres Risiko."
    },
    {
      "id": "scene-09",
      "type": "animation",
      "startFrame": 852,
      "durationFrames": 150,
      "plannedDurationSeconds": 5,
      "voiceText": "Wichtig: Ein grünes Match beweist nicht, dass Rechnung oder Empfänger seriös sind."
    },
    {
      "id": "scene-10",
      "type": "image",
      "startFrame": 1002,
      "durationFrames": 114,
      "plannedDurationSeconds": 3.8,
      "voiceText": "Der Check erkennt nur, ob Name und IBAN zusammenpassen."
    },
    {
      "id": "scene-11",
      "type": "animation",
      "startFrame": 1116,
      "durationFrames": 150,
      "plannedDurationSeconds": 5,
      "voiceText": "Bei Echtzeitüberweisungen ist das Geld in Sekunden da und grundsätzlich nicht einfach widerrufbar."
    },
    {
      "id": "scene-12",
      "type": "image",
      "startFrame": 1266,
      "durationFrames": 114,
      "plannedDurationSeconds": 3.8,
      "voiceText": "Bei einem Fehler: sofort deine Bank oder deinen Zahlungsdienstleister kontaktieren."
    },
    {
      "id": "scene-13",
      "type": "image",
      "startFrame": 1380,
      "durationFrames": 120,
      "plannedDurationSeconds": 4,
      "voiceText": "Die Bank kann eine Rückforderung versuchen; ob das Geld zurückkommt, kann vom Empfänger abhängen."
    },
    {
      "id": "scene-14",
      "type": "animation",
      "startFrame": 1500,
      "durationFrames": 144,
      "plannedDurationSeconds": 4.8,
      "voiceText": "Also: Warnung nicht wegklicken. Daten prüfen – dann erst senden."
    }
  ]
