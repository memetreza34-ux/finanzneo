{
  "layout": {
    "width": 1080,
    "height": 1920,
    "headline": {"top": 68, "left": 62, "right": 150, "dividerY": 222},
    "visual": {"top": 270, "bottom": 1280},
    "caption": {"top": 1360, "left": 62, "right": 150, "maxBottom": 1600},
