{
  "name": "finanzneo-brandkit",
  "version": "1.0.0",
  "description": "FinanzNeo Remotion-Studio für vertikale Finanz-Erklärvideos",
  "scripts": {
    "setup:check": "node scripts/check-setup.mjs",
    "studio": "npx remotion studio",
    "studio:drei-konten": "npm run assets:drei-konten && npx remotion studio",
    "studio:notgroschen": "npm run assets:notgroschen && npx remotion studio",
    "studio:etf-kosten-v2": "npm run assets:etf-kosten-v2 && npx remotion studio",
    "typecheck": "tsc --noEmit",
    "build": "npx remotion bundle src/index.ts",
    "reel:create": "node scripts/scaffold-finanzneo-reel-locked.mjs",
    "reel:sort-images": "node scripts/sort-reel-images.mjs",
    "reel:validate": "node scripts/validate-reel-locked.mjs",
    "validate:image-world": "node scripts/validate-global-image-world.mjs",
    "assets:drei-konten": "node scripts/sync-reel-assets.mjs drei-konten",
    "assets:notgroschen": "node scripts/sync-reel-assets.mjs notgroschen",
    "assets:zinseszins": "node scripts/sync-reel-assets.mjs zinseszins",
    "assets:etf-kosten-v2": "node scripts/sync-reel-assets.mjs etf-kosten-v2",
    "antigravity:safety": "node scripts/antigravity-repo-safety-check.mjs",
    "validate:compositions": "node scripts/validate-compositions.mjs",
    "validate:design-system": "node scripts/validate-design-system.mjs",
    "validate:finance": "node scripts/validate-finance.mjs",
    "validate:reel-template": "node scripts/validate-reel-template.mjs",
    "validate:short-hook": "node scripts/validate-assets.mjs manifests/short-hook.json",
    "validate": "npm run setup:check && npm run validate:image-world && npm run validate:compositions && npm run validate:design-system && npm run validate:finance && npm run validate:reel-template && npm run typecheck",
    "render": "npm run render:short-hook",
    "render:short-hook": "node scripts/render-validated.mjs manifests/short-hook.json",
    "reel:prepare": "node scripts/sync-reel-assets.mjs",
    "reel:preview": "node scripts/reel-render.mjs",
    "reel:render": "node scripts/reel-render.mjs",
    "reel:qa": "node scripts/reel-render.mjs --post-render",
    "render:preview": "npx remotion render src/index.ts ShortHook out/short-hook-preview.mp4 --scale=0.5",
    "render:template-demo": "npx remotion render src/index.ts ReelTemplateDemo out/reel-template-demo.mp4 --scale=0.5",
    "upgrade": "npx remotion upgrade"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.473",
    "@remotion/lottie": "^4.0.473",
    "@remotion/media-utils": "^4.0.473",
    "@remotion/motion-blur": "^4.0.473",
    "@remotion/paths": "^4.0.473",
    "@remotion/shapes": "^4.0.473",
    "@remotion/transitions": "^4.0.473",
    "lottie-web": "^5.13.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^3.8.1",
    "remotion": "^4.0.473"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/three": "^0.185.4",
    "typescript": "^5.0.0"
  }
}
