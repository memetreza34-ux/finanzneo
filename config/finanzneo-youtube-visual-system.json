{
  "id": "finanzneo-youtube-simple-finance-v2",
  "scope": "youtube-longform-only",
  "defaultAssetSource": "content-dependent",
  "imageWorld": "finanzneo-youtube-grounded-3d-black-v1",
  "imageWorldReferenceProject": "youtube/warum-dein-geld-verschwindet-images-only",
  "imageWorldReferencePolicy": "copy-last-good-video-exactly",
  "flowStoryboardStandard": "finanzneo-youtube-flow-storyboard-v1",
  "scriptVisualPlanningStandard": "finanzneo-youtube-script-visual-planning-v1",
  "thumbnailContract": {
    "finalCoverTextRequired": true,
    "headlineMustBePresentBeforeFinalExport": true,
    "recommendedHeadlineWords": [2, 6],
    "preferredHeadlineOwner": "flow-generated-final-thumbnail",
    "directGeneratedHeadlineRequired": true,
    "thumbnailDirectTextExceptionToRemotionTextRule": true,
    "flowHeadlineMustBeExactOrRegenerated": true,
    "finalQaMustVerifyReadableHeadline": true,
    "noTextThumbnailForbiddenAsFinal": true
  },
  "layoutContract": {
    "id": "finanzneo-youtube-framed-scene-v2",
    "frameWidth": 1920,
    "frameHeight": 1080,
    "sceneHeadingRequired": true,
    "sceneIconRequired": true,
    "flowImageFullscreenForbidden": true,
    "flowImagePlacement": "contained-visual-window",
    "deepBlackFrameBackgroundVisibleForFlow": true,
    "headingAndIconOutsideFlowImage": true,
    "phaseAStaticUsesContainedVisualWindow": true,
    "hybridPureRemotionMayUseFullFrame": true,
    "hybridRemotionOverlayMayExtendBeyondFlowWindow": true,
    "hybridFlowImageItselfRemainsContained": true,
    "hybridMotionCanvas": "full-1920x1080",
    "motionSafeAreaPx": 64,
    "unintentionalCroppingForbidden": true,
    "criticalContentMustRemainInsideSafeArea": true,
    "recommendedOuterMarginPx": 72,
    "recommendedHeaderHeightPx": [150, 190],
    "recommendedIconSizePx": [56, 72],
    "recommendedVisualWindowMaxWidthRatio": 0.78,
    "recommendedVisualWindowMaxHeightRatio": 0.70
  },
  "productionModes": {
    "images-only": {
      "description": "Phase A Static: same approved image world, no animation. Static Flow stories, static Flow+Remotion explainers, static data visuals and real assets are allowed.",
      "semanticName": "phase-a-static",
      "animationDisabledOnly": true,
      "allowedVisualTypes": ["image", "hybrid", "data", "real-asset"],
      "forbiddenVisualTypes": ["animation"],
      "allowedStaticVisualKinds": ["3d-story", "3d-explainer", "static-data", "real-asset"],
      "staticSceneLayoutRequired": true,
      "staticLayoutAssemblyAllowed": true,
      "staticHybridOverlaysAllowed": true,
      "remotionAnimationAllowed": false,
      "flowImageRequiredForEveryScene": false,
      "oneMainIdeaPerVisual": true,
      "recommendedVoiceoverSentencesPerImage": [1, 2],
      "mixIsHardQuota": false
    },
    "hybrid": {
      "description": "Phase B permits motion but never requires it. Choose the strongest visual per beat: strong image, static explainer, image+Remotion with distinct jobs, pure motion only when time/change is clearer in motion, or a real asset.",
      "allowedVisualTypes": ["image", "hybrid", "animation", "data", "real-asset"],
      "remotionAnimationAllowed": true,
      "fullFrameRemotionAllowed": true,
      "fullFrameFlowForbidden": true,
      "imagePlusRemotionAllowedOnlyWhenRolesDiffer": true,
      "oneMainIdeaPerVisual": true,
      "recommendedVoiceoverSentencesPerImage": [1, 2],
      "visualBalanceGuidance": {"hardQuota": false, "percentageTargetsForbidden": true, "diagnosticOnly": true, "rule": "Never add animation, hybrid layers or extra images merely to hit a mix. Use as many strong images, diagrams, examples or motion scenes as the script actually needs."},
      "motionGate": {"motionMustExplainTemporalChangeOrDirectAttention": true, "animationMustBeatStaticAlternative": true, "strongStaticImageMayReplaceAnimation": true, "staticDiagramMayReplaceAnimation": true, "weakAnimationMustBeDowngraded": true, "motionForMotionSakeForbidden": true},
      "hybridOverlapGuard": {"imageAndMotionNeedDistinctJobs": true, "semanticOverlapForbidden": true, "motionMustNotRepeatWhatImageAlreadyExplains": true, "imageMustNotRepeatWhatMotionAlreadyExplains": true, "ifRolesOverlapChooseSingleStrongerMedium": true},
      "scriptVisualPlanning": {"planVisualBeforeFinalizingEachScriptBeat": true, "eachBeatNeedsVisualIntent": true, "eachMotionBeatNeedsStaticAlternative": true, "eachHybridBeatNeedsDivisionOfLabor": true, "rewriteWeaklyVisualizableScriptBeat": true, "factsMustNotBeDistortedForVisualConvenience": true},
      "visualVarietyGuard": {"sameVisualLogicRepeatedWithoutReasonForbidden": true, "adjacentRepeatedTemplateNeedsReason": true, "varietyServesClarityNotNovelty": true},
      "humanUsageGuidance": {"recommendedMaxShare": 0.4, "hardLimit": false, "useOnlyWhen": ["reaction", "choice", "attention", "consequence"], "avoidRepeatedHumanTemplate": true, "avoidConsecutiveHumanScenesWhenNotNeeded": true},
      "abstractionGuard": {"abstractOnlySceneNeedsClearExplanatoryAdvantage": true, "avoidMultipleAbstractSchemasInARow": true, "preferConcreteAnchorWhenMeaningWouldOtherwiseBeAmbiguous": true, "staticDiagramOrExamplePreferredWhenMotionAddsNoValue": true}
    }
  },
  "principles": {
    "simplestVisualFirst": true,
    "contentFirstNotToolFirst": true,
    "scriptAndVisualPlanAreDesignedTogether": true,
    "oneMainIdeaPerVisual": true,
    "recommendedVoiceoverSentencesPerFlowImage": [1, 2],
    "splitMultiIdeaBeats": true,
    "sceneHeadingRequiredInEveryMode": true,
    "sceneIconRequiredInEveryMode": true,
    "flowImageFullscreenForbiddenInEveryMode": true,
    "sharedBrandLogicAcrossModes": true,
    "sameSceneLayoutAcrossModes": false,
    "phaseBMayUseFullFrameRemotion": true,
    "phaseBDoesNotRequireMotion": true,
    "imagesOnlyModeDisablesAnimationNotLayout": true,
    "remotionOwnsExactInVideoTextAndNumbers": true,
    "thumbnailHeadlineIsDirectGenerationException": true,
    "flowImageCanReserveNegativeSpaceForOverlays": true,
    "hybridOnlyWhenImageAndMotionHaveDistinctJobs": true,
    "semanticImageMotionOverlapForbidden": true,
    "strongStaticVisualMayReplaceWeakAnimation": true,
    "diagramExampleOrComparisonMayReplaceAnimation": true,
    "realAssetsPreferredOverGeneratedImitations": true,
    "stylized3DForFlowImages": true,
    "imageWorldMustMatchLastGoodReferenceProject": true,
    "flowCharactersMustBelongToSameAnimationFilmWorld": true,
    "blankFacelessMannequinForbidden": true,
    "thumbnailTextRequired": true,
    "thumbnailTextGeneratedDirectlyInFinalThumbnail": true,
    "thumbnailTextAppliedBeforeFinalExport": true,
    "simpleCompositionDoesNotMeanFlatIllustration": true,
    "simpleCompositionDoesNotMeanBoringStaging": true,
    "flowVisualStorytellingRequired": true,
    "staticCatalogDefaultForbidden": true,
    "stagingMustFollowSpokenPoint": true,
    "repeatedFloatingObjectTemplateForbidden": true,
    "repeatedVisualLogicWithoutReasonForbidden": true,
    "reusableExplainerPatternsAreAllowed": true,
    "noveltyForItsOwnSake": false,
    "unintentionalCropForbidden": true
  },
  "hybridDecisionOrder": [
    "Decide what the viewer must understand or remember",
    "Choose the best static visual first: story image, concrete example, comparison, diagram, chart or calculation",
    "Ask whether time/change is essential and whether motion is clearly stronger than the static alternative",
    "Use image+Remotion only when image and motion have different non-overlapping jobs",
    "If image and motion communicate the same thing, keep only the stronger medium",
    "Choose pure Remotion when process/change over time is genuinely clearer in motion",
    "Choose real asset when reality/source evidence matters",
    "Before locking the script beat, confirm the chosen visual is producible and not a repeat of recent visual logic"
  ],
  "remotionBestFor": ["big-number", "comparison", "percentage", "bar-chart", "line-chart", "timeline", "money-flow", "process-steps", "simple-diagram", "highlight-text", "allocation", "formula"],
  "staticExplainerBestFor": ["diagram", "before-after", "comparison", "worked-example", "calculation", "three-step-summary", "simple-chart", "labelled-object", "cause-effect-map"],
  "flowBestFor": ["everyday-finance-situation", "concrete-real-world-problem", "human-scale-context", "simple-emotional-moment", "physical-cause-effect-story"],
  "hybridBestFor": ["real-world-image-plus-exact-number", "image-plus-nonredundant-money-flow", "image-plus-nonredundant-highlight", "image-plus-temporal-change-that-the-still-cannot-show"],
  "flowPromptSections": ["FINAL FILE NAME", "VOICEOVER CONTEXT", "SCENE", "IMPORTANT GERMAN OBJECT LABELS", "OBJECTS", "VISUAL STORYTELLING", "COMPOSITION", "MATERIALS", "BACKGROUND", "LIGHTING", "COLOR LANGUAGE", "TEXT", "FORBIDDEN"],
  "flowHandoff": {"singleSharedPromptMayContainMultipleImageBlocks": true, "fixedImageBlockCount": false, "generateSequentiallyOnly": true, "waitRenameQaBeforeNext": true},
  "standardMotionPresets": ["STATIC", "FADE_IN", "SLIDE_UP", "SLIDE_LEFT", "SCALE_IN", "COUNT_UP", "BAR_GROW", "LINE_DRAW", "HIGHLIGHT", "SLOW_ZOOM"],
  "qa": [
    "main idea understandable in 1-2 seconds",
    "one dominant thought",
    "script beat already has a clear visual plan before it is considered final",
    "final thumbnail is generated with its exact short strong readable headline already inside the image",
    "thumbnail with missing misspelled distorted or unreadable headline is regenerated before continuing",
    "Flow image visibly matches the approved last-good-video stylized premium 3D animation-film world",
    "human characters are used only when reaction choice attention or consequence materially helps",
    "Flow image contains a meaningful visual relationship or story",
    "exact explanatory in-video text and important numbers are rendered by the video layout",
    "Phase A contains no frame-to-frame animation",
    "Phase B never adds motion merely because motion is available",
    "every animated beat is stronger in motion than its static alternative",
    "pure Remotion in Phase B may use the full 1920x1080 canvas",
    "Flow imagery itself is never fullscreen",
    "no important animation element is unintentionally cropped or clipped",
    "critical animated content remains inside the 64 px motion safe area",
    "simpler visual would not work equally well"
  ]
}
