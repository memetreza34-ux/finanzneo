{
  "id": "finanzneo-youtube-simple-finance-v1",
  "scope": "youtube-longform-only",
  "defaultAssetSource": "mode-dependent",
  "imageWorld": "finanzneo-youtube-grounded-3d-black-v1",
  "flowStoryboardStandard": "finanzneo-youtube-flow-storyboard-v1",
  "layoutContract": {
    "id": "finanzneo-youtube-framed-scene-v1",
    "sceneHeadingRequired": true,
    "sceneIconRequired": true,
    "flowImageFullscreenForbidden": true,
    "flowImagePlacement": "contained-visual-window",
    "deepBlackFrameBackgroundVisible": true,
    "headingAndIconOutsideFlowImage": true,
    "recommendedOuterMarginPx": 72,
    "recommendedHeaderHeightPx": [150, 190],
    "recommendedIconSizePx": [56, 72],
    "recommendedVisualWindowMaxWidthRatio": 0.78,
    "recommendedVisualWindowMaxHeightRatio": 0.70
  },
  "productionModes": {
    "images-only": {
      "description": "Static YouTube scenes with the normal framed FinanzNeo layout: heading, matching icon and contained Flow image; no animation.",
      "allowedVisualTypes": ["image"],
      "staticSceneLayoutRequired": true,
      "staticLayoutAssemblyAllowed": true,
      "remotionExplainerVisualsAllowed": false,
      "remotionAnimationAllowed": false,
      "staticImageVisualsOnly": true,
      "oneMainIdeaPerVisual": true,
      "recommendedVoiceoverSentencesPerImage": [1, 2]
    },
    "hybrid": {
      "description": "Same framed FinanzNeo scene layout as images-only, with heading, icon and contained visual; animation and additional explainer visuals are allowed.",
      "allowedVisualTypes": ["image", "hybrid", "animation", "data", "real-asset"],
      "staticSceneLayoutRequired": true,
      "staticLayoutAssemblyAllowed": true,
      "remotionExplainerVisualsAllowed": true,
      "remotionAnimationAllowed": true,
      "staticImageVisualsOnly": false,
      "oneMainIdeaPerVisual": true,
      "recommendedVoiceoverSentencesPerImage": [1, 2]
    }
  },
  "principles": {
    "simplestVisualFirst": true,
    "oneMainIdeaPerVisual": true,
    "recommendedVoiceoverSentencesPerFlowImage": [1, 2],
    "splitMultiIdeaBeats": true,
    "sceneHeadingRequiredInEveryMode": true,
    "sceneIconRequiredInEveryMode": true,
    "flowImageFullscreenForbiddenInEveryMode": true,
    "sameSceneLayoutAcrossModes": true,
    "imagesOnlyModeDisablesAnimationNotLayout": true,
    "remotionOwnsTextAndNumbersInHybridMode": true,
    "flowRequiresJustificationInHybridMode": true,
    "flowIsPrimaryVisualSourceInImagesOnlyMode": true,
    "realAssetsPreferredOverGeneratedImitations": true,
    "stylized3DForFlowImages": true,
    "simpleCompositionDoesNotMeanFlatIllustration": true,
    "simpleCompositionDoesNotMeanBoringStaging": true,
    "flowVisualStorytellingRequired": true,
    "staticCatalogDefaultForbidden": true,
    "stagingMustFollowSpokenPoint": true,
    "repeatedFloatingObjectTemplateForbidden": true,
    "reusableExplainerPatternsAreAllowedInHybridMode": true,
    "noveltyForItsOwnSake": false
  },
  "assetDecisionOrderByMode": {
    "images-only": ["google-flow"],
    "hybrid": ["remotion", "real-asset", "google-flow"]
  },
  "remotionBestFor": [
    "big-number",
    "comparison",
    "percentage",
    "bar-chart",
    "line-chart",
    "timeline",
    "money-flow",
    "process-steps",
    "simple-diagram",
    "highlight-text",
    "allocation",
    "formula"
  ],
  "realAssetBestFor": [
    "website",
    "app-screen",
    "document",
    "factsheet",
    "logo",
    "product",
    "source-evidence"
  ],
  "flowBestFor": [
    "everyday-finance-situation",
    "concrete-real-world-problem",
    "human-scale-context",
    "simple-emotional-moment",
    "physical-cause-effect-story"
  ],
  "flowPromptSections": [
    "FINAL FILE NAME",
    "VOICEOVER CONTEXT",
    "SCENE",
    "IMPORTANT GERMAN OBJECT LABELS",
    "OBJECTS",
    "VISUAL STORYTELLING",
    "COMPOSITION",
    "MATERIALS",
    "BACKGROUND",
    "LIGHTING",
    "COLOR LANGUAGE",
    "TEXT",
    "FORBIDDEN"
  ],
  "flowHandoff": {
    "singleSharedPromptMayContainMultipleImageBlocks": true,
    "fixedImageBlockCount": false,
    "generateSequentiallyOnly": true,
    "waitRenameQaBeforeNext": true
  },
  "standardMotionPresets": [
    "FADE_IN",
    "SLIDE_UP",
    "SLIDE_LEFT",
    "SCALE_IN",
    "COUNT_UP",
    "BAR_GROW",
    "LINE_DRAW",
    "HIGHLIGHT",
    "SLOW_ZOOM"
  ],
  "flowGate": {
    "images-only": "Flow is the planned visual source; still reject a scene if it cannot communicate one clear spoken point as a strong static image inside the framed scene layout.",
    "hybrid": {
      "question": "Can text, number, icon, chart, diagram, screenshot or real asset explain this equally well or better?",
      "ifYes": "forbid-flow",
      "ifNo": "allow-flow-with-reason"
    }
  },
  "qa": [
    "main idea understandable in 1-2 seconds",
    "one dominant thought",
    "scene has a short heading",
    "scene has one matching icon",
    "Flow image is contained inside the scene layout and never fills the whole frame",
    "deep-black FinanzNeo frame remains visibly present around the contained visual",
    "Flow voiceover beat is normally 1-2 short sentences",
    "multi-idea beat is split into more visuals",
    "Flow image uses the approved stylized premium 3D animation-film world",
    "Flow image is never generic flat corporate/editorial art",
    "Flow image contains a meaningful visual relationship or story",
    "Flow image is not a static tabletop/catalog product shot",
    "staging follows the spoken point instead of repeating a template",
    "ambiguous important objects use short physical German labels when needed",
    "nothing decorative can be removed without losing meaning",
    "images-only mode contains no animation but keeps the full static scene layout",
    "hybrid mode uses Flow only when justified",
    "simpler visual would not work equally well"
  ]
}
