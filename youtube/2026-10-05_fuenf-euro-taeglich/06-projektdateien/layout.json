      "icon": "calendar"
    },
    {
      "id": "visual-03",
      "title": "Der 30-Tage-Effekt",
      "icon": "calendar"
    },
    {
      "id": "visual-04",
      "title": "Was daraus in einem Jahr wird",
      "icon": "clock"
    },
    {
      "id": "visual-05",
      "title": "Warum 5 € so klein wirken",
      "icon": "repeat"
    },
    {
      "id": "visual-06",
      "title": "Andere Ausgabe, gleiche Gewohnheit",
      "icon": "wallet"
    },
    {
      "id": "visual-07",
      "title": "Der 7-Tage-Test",
      "icon": "list"
    },
    {
      "id": "visual-08",
      "title": "Mach kleine Ausgaben sichtbar",
      "icon": "target"
    }
  ],
  "thumbnailTimelineForbidden": true
